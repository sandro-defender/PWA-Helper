{
  "id": "/HIPSBNVemXtM8VMwRfWs",
  "name": "You.Ge Assistant",
  "short_name": "You.Ge",
  "description": "Your installable, offline-ready web assistant.",
  "start_url": "/?launchedfrom=homescreen",
  "scope": "/",
  "display": "standalone",
  "dir": "auto",
  "background_color": "#f8fafc",
  "theme_color": "#155eef",
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["image/*", "video/*", "audio/*", "text/plain", "application/pdf"] }]
    }
  },
  "protocol_handlers": [
    { "protocol": "web+pwa", "url": "/?launchedfrom=homescreen&pwaprotocolredirect=%s" },
    { "protocol": "web+loldwyhv", "url": "/?launchedfrom=homescreen&pwaprotocolredirect=%s" }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
