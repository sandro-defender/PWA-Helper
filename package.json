{
  "name": "you-ge-assistant",
  "version": "1.0.5",
  "private": true,
  "description": "You.Ge Assistant: a dependency-free, multi-domain PWA toolkit with installation, offline support, sharing, push, badges, QR codes and network diagnostics.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pwa",
    "service-worker",
    "web-manifest",
    "web-push",
    "install-prompt",
    "offline",
    "progressier"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-deployment.mjs",
    "keys": "node scripts/generate-vapid-keys.mjs --write"
  }
}
