{
  "name": "you-ge-assistant",
  "version": "1.0.5",
  "private": true,
  "description": "You.Ge Assistant: a dependency-free, multi-domain PWA toolkit with installation, offline support, sharing, push, badges, QR codes and diagnostics; foundation for the future dashboard and single SDK package.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "you-ge",
    "assistant",
    "pwa",
    "service-worker",
    "web-manifest",
    "web-push",
    "install-prompt",
    "offline",
    "progressier"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs packages/assistant-sdk/tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs packages/assistant-sdk/tests/*.test.mjs",
    "test:sdk": "node --test packages/assistant-sdk/tests/*.test.mjs",
    "sync:sdk": "node scripts/sync-sdk-browser.mjs",
    "verify": "node scripts/verify-deployment.mjs",
    "keys": "node scripts/generate-vapid-keys.mjs --write"
  }
}
